{
  "extends": "@chaku/config/tsconfig/node.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    // The CLI runs as TypeScript straight in Node.js, which needs the .ts extension on imports.
    "allowImportingTsExtensions": true
  },
  "include": ["*.js", "src/**/*.ts", "test/**/*.ts", "live/**/*.ts"]
}
