{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "test": {
      // The tests read the stack and docs files at the repo root, and its package.json scripts.
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/docker-compose.yml",
        "$TURBO_ROOT$/.env.example",
        "$TURBO_ROOT$/CLAUDE.md",
        "$TURBO_ROOT$/docs/README.md",
        "$TURBO_ROOT$/docs/guides/**",
        "$TURBO_ROOT$/docs/process/workflow.md",
        "$TURBO_ROOT$/.mcp.json",
        "$TURBO_ROOT$/.claude/skills/**"
      ]
    }
  }
}
