{
  "extends": "@chaku/config/tsconfig/node.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    // Runs as TypeScript straight in Node.js in development, which needs the .ts extension on imports.
    "allowImportingTsExtensions": true
  },
  "include": ["*.js", "*.ts", "src/**/*.ts", "test/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
