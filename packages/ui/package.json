{
  "name": "@chaku/ui",
  "private": true,
  "type": "module",
  "exports": {
    "./tokens": "./src/tokens/index.ts",
    "./tokens.css": "./tokens.css"
  },
  "scripts": {
    "lint": "eslint . && stylelint --allow-empty-input \"**/*.css\"",
    "typecheck": "tsc",
    "test": "vitest run --project unit",
