    "tokens": "node scripts/tokens.ts",
    "storybook": "storybook dev --port 6006 --no-open",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@chaku/config": "workspace:*",
    "@storybook/addon-a11y": "catalog:",
