# Local values for the stack (D23, ADR-0006). No secrets: everything here only works on your
# machine. Copy to .env to change something; `pnpm stack` reads .env first, then this file.
# Guide: docs/guides/local-development.md

# Host ports of the stack, on 127.0.0.1. Move one if something else already listens there,
# and change the matching URL below.
CHAKU_POSTGRES_PORT=5432
CHAKU_REDIS_PORT=6379
CHAKU_SMTP_PORT=1025
CHAKU_S3_PORT=8333

# Sites, served over HTTPS by Caddy
APP_URL=https://chaku.localhost
REALTIME_URL=wss://rt.chaku.localhost
REFERENCE_GAME_URL=https://reference.chakugames.localhost
# Every Game runs on a subdomain of the games domain, in a frame (ADR-0002); the CSP allows them all.
GAMES_DOMAIN=chakugames.localhost

# trace, debug, info, warn, error or fatal
LOG_LEVEL=info

DATABASE_URL=postgres://chaku:chaku@127.0.0.1:5432/chaku
REDIS_URL=redis://127.0.0.1:6379

# Login (Better Auth, ADR-0004). The secret signs session cookies; this one only works locally,
# and every deployed environment sets its own. Passkeys are bound to PASSKEY_RP_ID (D41).
BETTER_AUTH_SECRET=local-only-not-a-secret-0000000000000000
PASSKEY_RP_ID=chaku.localhost
# Google login is optional locally: set both in .env with a development OAuth client to turn it on
# (redirect URI https://chaku.localhost/api/auth/callback/google). Empty means off (ADR-0010).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mailpit catches every email; read them at https://mail.chaku.localhost
SMTP_URL=smtp://127.0.0.1:1025
EMAIL_FROM="Chaku <no-reply@chaku.localhost>"

# SeaweedFS stands in for Cloudflare R2. Server code talks to S3_ENDPOINT; browsers use
# S3_PUBLIC_ENDPOINT, so pre-signed links are signed for that host.
S3_ENDPOINT=http://127.0.0.1:8333
S3_PUBLIC_ENDPOINT=https://s3.chaku.localhost
S3_REGION=auto
S3_ACCESS_KEY_ID=chaku-local
S3_SECRET_ACCESS_KEY=chaku-local-secret
S3_BUCKET_PRIVATE=chaku-private
S3_BUCKET_PUBLIC=chaku-public
